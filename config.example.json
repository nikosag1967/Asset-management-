{
  "tenantId": "00000000-0000-0000-0000-000000000000",
  "clientId": "00000000-0000-0000-0000-000000000000",
  "certificateThumbprint": "THUMBPRINT_OF_CERT_IN_LOCALMACHINE_OR_CURRENTUSER_MY_STORE",

  "outputPath": "..\\web\\data\\devices.json",
  "historyPath": "..\\web\\data\\history.json",
  "logPath": "..\\logs\\asset-sync.log",

  "staleAfterDays": 30,
  "includeByod": true,
  "maxHistoryEntries": 500,

  "sharePoint": {
    "enabled": true,
    "siteId": "contoso.sharepoint.com,<siteCollectionGuid>,<webGuid>",
    "registerListId": "<Asset Register list GUID>",
    "documentsListId": "<Asset Documents library GUID>",
    "libraryUrl": "https://contoso.sharepoint.com/sites/Assets/Asset%20Documents",
    "registerFields": {
      "assetTag": "Title",
      "serial": "SerialNumber",
      "category": "Category",
      "manufacturer": "Manufacturer",
      "model": "Model",
      "purchaseDate": "PurchaseDate",
      "purchasePrice": "PurchasePrice",
      "supplier": "Supplier",
      "invoiceNo": "InvoiceNo",
      "warrantyEnd": "WarrantyEnd",
      "costCentre": "CostCentre",
      "department": "Department",
      "location": "Location",
      "status": "LifecycleStatus",
      "assignedTo": "AssignedTo",
      "replaceDate": "ReplaceDate",
      "notes": "Notes"
    },
    "documentFields": {
      "assetKey": "AssetKey",
      "docType": "DocType",
      "validUntil": "ValidUntil"
    }
  },

  "licenses": {
    "enabled": true,
    "listId": "<Licenses & Certificates list GUID>",
    "fields": {
      "name": "Title",
      "itemType": "ItemType",
      "subtype": "Subtype",
      "vendor": "Vendor",
      "reference": "Reference",
      "seatsTotal": "SeatsTotal",
      "startDate": "StartDate",
      "expiryDate": "ExpiryDate",
      "autoRenew": "AutoRenew",
      "cost": "RenewalCost",
      "owner": "Owner",
      "status": "LifecycleStatus",
      "renewedBy": "RenewedByLookupId",
      "assignedUsers": "AssignedUsers",
      "assignedDevices": "AssignedDevices",
      "assignedResources": "AssignedResources"
    }
  },

  "expiry": {
    "warnDays": 60,
    "critDays": 30
  },

  "digest": {
    "thresholds": [60, 30, 14, 7],
    "statePath": "..\\data\\alert-state.json",
    "maxDataAgeHours": 24,
    "email": {
      "enabled": false,
      "from": "assets@contoso.com",
      "to": ["it-team@contoso.com"],
      "notifyOwners": true
    }
  },

  "alerts": {
    "teamsWebhookUrl": ""
  },

  "ui": {
    "intunePortalDeviceUrl": "https://intune.microsoft.com/#view/Microsoft_Intune_Devices/DeviceSettingsMenuBlade/~/overview/mdmDeviceId/{intuneId}"
  }
}
